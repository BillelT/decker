{
  "name": "@figma-to-slides/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "prebuild": "npm --prefix ../shared run build",
    "build": "tsc -p tsconfig.json",
    "predev": "npm --prefix ../shared run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pretest": "npm --prefix ../shared run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit",
    "precalibrate": "npm --prefix ../shared run build",
    "calibrate": "tsx src/calibration/calibrate.ts"
  },
  "dependencies": {
    "@figma-to-slides/shared": "0.1.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/functions": "^3.7.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "google-auth-library": "^10.9.1",
    "multer": "^2.0.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "ssim.js": "^3.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}

PORT=8787
# Slides va chercher lui-même chaque image/asset exporté depuis les serveurs
# Google — "localhost" n'est joignable que depuis cette machine. Pour tester
# un export contenant une image ou un élément rasterisé (dégradé, ombre,
# LINE…), expose ce backend via un tunnel public (ex. `ngrok http 8787`) et
# mets ici l'URL https donnée par le tunnel à la place.
PUBLIC_BACKEND_URL=http://localhost:8787

# Google Cloud Console > APIs & Services > Credentials (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/callback

# 32 bytes hex-encoded (64 hex chars) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# Comma-separated list of origins allowed to call this backend
# (the Figma plugin iframe origin — see manifest.json networkAccess.allowedDomains).
PLUGIN_ALLOWED_ORIGINS=

# local-disk (dev only, see LIMITATIONS.md) | vercel-blob (see README §8, deployed on Vercel) | s3 (Cloudflare R2, egress gratuit — voir bloc S3_* ci-dessous)
ASSET_STORAGE_DRIVER=local-disk
ASSET_TTL_MS=900000
ASSET_LOCAL_DIR=.data/assets

# Driver s3 (testé contre Cloudflare R2) — setup :
#   1. dash.cloudflare.com > R2 Object Storage > Create bucket
#   2. Sur le bucket : Settings > Public access > Allow Access (active la
#      "Public Development URL", ex. https://pub-xxxx.r2.dev) — ou branche un
#      domaine custom si tu en as un. Cette URL va dans S3_PUBLIC_BASE_URL.
#   3. R2 > Manage API tokens > Create API token (permissions "Object Read &
#      Write", limité à ce bucket) — donne S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
#   4. S3_ENDPOINT = https://<account_id>.r2.cloudflarestorage.com
#      (account_id visible dans l'URL du dashboard Cloudflare ou à côté du
#      token créé à l'étape 3).
# Sur Vercel : ajoute ces 5 variables dans Project Settings > Environment
# Variables, puis passe ASSET_STORAGE_DRIVER=s3 (au lieu de vercel-blob).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# S3_REGION=auto (défaut déjà correct pour R2, inutile de le fixer)

# Sessions/jobs/PKCE (src/kv.ts) — optionnel en dev local : sans ces
# variables, un store en mémoire équivalent prend le relais automatiquement
# (juste un avertissement au démarrage). Nécessaire pour un déploiement
# Vercel (README §8), où l'une des deux paires suivantes est injectée
# automatiquement en liant un store Redis (Upstash) au projet :
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# KV_REST_API_URL / KV_REST_API_TOKEN (nommage historique Vercel KV)

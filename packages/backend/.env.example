PORT=8787
# Slides va chercher lui-même chaque image/asset exporté depuis les serveurs
# Google — "localhost" n'est joignable que depuis cette machine. Pour tester
# un export contenant une image ou un élément rasterisé (dégradé, ombre,
# LINE…), expose ce backend via un tunnel public (ex. `ngrok http 8787`) et
# mets ici l'URL https donnée par le tunnel à la place.
PUBLIC_BACKEND_URL=http://localhost:8787

# Google Cloud Console > APIs & Services > Credentials (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/callback

# 32 bytes hex-encoded (64 hex chars) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# Comma-separated list of origins allowed to call this backend
# (the Figma plugin iframe origin — see manifest.json networkAccess.allowedDomains).
PLUGIN_ALLOWED_ORIGINS=

# local-disk (dev only, see LIMITATIONS.md) | s3 (not implemented yet, spec §5.3)
ASSET_STORAGE_DRIVER=local-disk
ASSET_TTL_MS=900000
ASSET_LOCAL_DIR=.data/assets
